# Secrets — never commit
.env
.env.*
*.env
!ceraa.env.example
*.local
# Encrypted secret stores. A test that initialises the store with a relative
# path writes these next to the package; they hold real, decryptable tokens.
secret.key
secrets.json
*.secret.key

# Build/local artifacts
dist/
sessions/
bin/
.lock
testdata-fuzz/

# Scratch output from an agent run. Screenshots and generated files land here and
# must never be tracked; landing.html was accidentally committed this way.
/workspace/

# User uploads over Telegram. Real documents from a real person, landing in
# files/ by design; tracking them would push private material to GitHub on the
# next git add -A, which the auto-push rule runs after every fix.
files/

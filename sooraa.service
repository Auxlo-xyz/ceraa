[Unit]
Description=Sooraa Telegram Bot
After=network.target

[Service]
Type=simple
WorkingDirectory=/workspace/sooraa
# Secrets live in /etc/sooraa/sooraa.env (chmod 600). See sooraa.env.example.
EnvironmentFile=/etc/sooraa/sooraa.env
ExecStart=/workspace/sooraa/bin/sooraa telegram
Restart=always
RestartSec=10
StandardOutput=append:/tmp/sooraa-service.log
StandardError=append:/tmp/sooraa-service.log

[Install]
WantedBy=multi-user.target

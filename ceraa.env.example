# Ceraa secrets template — copy to a non-tracked location and fill in.
# Used by ceraa.service (EnvironmentFile=/etc/ceraa/ceraa.env)
# and by run-ceraa.sh / start-bot.sh / start-daemon.sh.
#
# There is deliberately no default provider. Ceraa ships with no URL, model, or
# key baked in, so on first run it asks which provider to use and stores the
# answer per provider. Set these only if you want to pre-seed a provider from
# the environment instead of choosing in Telegram.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Allowlisted Telegram user/chat ID
TELEGRAM_ALLOWED_USER_ID=

# Optional: pre-seed an OpenAI-compatible provider instead of using Telegram
# onboarding. Leave blank to choose a provider in Telegram.
CERAA_API_URL=
CERAA_MODEL=
CERAA_API_KEY=

# Where the bot should run
HOME=/home/assistant

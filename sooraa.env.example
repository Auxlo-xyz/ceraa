# Sooraa secrets template — copy to a non-tracked location and fill in.
# Used by sooraa.service (EnvironmentFile=/etc/sooraa/sooraa.env)
# and by run_sooraa.sh / start_bot.sh / start_daemon.sh.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Allowlisted Telegram user/chat ID
TELEGRAM_ALLOWED_USER_ID=

# OpenAI-compatible provider
SOORAA_API_URL=https://inference.poolside.ai/v1
SOORAA_MODEL=poolside/laguna-xs-2.1
SOORAA_API_KEY=

# Where the bot should run
HOME=/home/assistant
